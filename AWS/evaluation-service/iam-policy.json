{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": [
        "arn:aws:secretsmanager:us-east-2:570814275471:secret:evaluation-service/SERVICE_API_KEY*",
        "arn:aws:secretsmanager:us-east-2:570814275471:secret:evaluation-service/REDIS_URL*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessage"
      ],
      "Resource": [
        "arn:aws:sqs:us-east-2:570814275471:ToggleMasterQueue"
      ]
    }
  ]
}
